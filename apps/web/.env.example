# Copy to .env.local (git-ignored) and adjust. No keys or tokens belong here:
# the Cesium ion token reaches the app only through the API's /v1/client-config.

# Where the serving API runs.
VITE_API_BASE=http://127.0.0.1:8010

# 1 = use the bundled example responses in src/mocks/fixtures instead of the API.
VITE_USE_MOCKS=0

# Folder with halifax.pmtiles, fonts/ and sprites/ (served at /tiles by the dev and preview servers).
HALIFAX_TWIN_TILES_DIR=C:\halifax-twin-data\tiles
