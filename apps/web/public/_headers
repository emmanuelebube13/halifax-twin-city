# Cloudflare Pages response headers for the public site (hfxtwin.profine.ca). Other hosts ignore this file.
# Built files have a content hash in their name, so they can be kept for a year; the page itself is always
# checked, so a new deploy shows up on the next visit.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/cesium/*
  Cache-Control: public, max-age=604800

/tiles/v/*
  Content-Type: application/x-protobuf
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/tiles/fonts/*
  Cache-Control: public, max-age=31536000, immutable
