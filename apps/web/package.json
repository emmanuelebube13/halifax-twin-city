{
  "name": "halifax-twin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Halifax Digital Twin web map (release 1)",
  "scripts": {
    "postinstall": "node scripts/copy-cesium.mjs",
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshots.mjs",
    "fixtures": "node scripts/copy-fixtures.mjs",
    "a11y": "node scripts/a11y.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@protomaps/basemaps": "5.7.2",
    "cesium": "1.130.1",
    "maplibre-gl": "5.24.1",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
