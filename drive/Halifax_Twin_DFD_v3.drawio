        <mxCell id="n581" value="&lt;b&gt;D1.1&lt;/b&gt; data name (noun)" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0F6E56;strokeWidth=1.5;fontSize=11;fontColor=#444441;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="n574" target="n576">
          <mxGeometry x="0.486" relative="1" as="geometry">
            <Array as="points">
