        <mxCell id="n579" value="&lt;b&gt;D10&lt;/b&gt;&amp;nbsp;&amp;nbsp;Transit service levels and delays" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=1;top=1;bottom=1;right=0;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1290" y="470" width="270" height="38" as="geometry" />
