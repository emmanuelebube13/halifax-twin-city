# Halifax Digital Twin: environment variables read by the code.
# Copy to .env (git-ignored) or set them as Windows user variables.
# Placeholders only. Never put a real token or password in this file.

# Database connection, with no password in it. The password is read from
# %APPDATA%\postgresql\pgpass.conf by psql and psycopg.
HALIFAX_TWIN_DB_URL=postgresql://postgres@localhost:5433/halifax_twin

# Data root outside the repository and OneDrive: raw files, logs, tiles.
HALIFAX_TWIN_DATA_DIR=C:\halifax-twin-data

# Cesium ion token for realistic 3D. Leave empty for 2D only.
# Set it as a user environment variable (engineering/runbooks/setup-windows.md, section 9).
CESIUM_ION_TOKEN=
